<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#DD000000">
    <org.osmdroid.views.MapView android:id="@+id/mapView" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layout_margin="8dp" android:background="#FFFFFF"/>
    <ImageButton android:id="@+id/btnCloseMap" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="#FF0000" android:tint="#FFFFFF"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_margin="16dp" android:background="#CC000000"
        android:padding="8dp" android:orientation="vertical">
        <TextView android:text="🟢 MOI" android:textColor="#4CAF50" android:textSize="12sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="🔵 L'AUTRE" android:textColor="#2196F3" android:textSize="12sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
